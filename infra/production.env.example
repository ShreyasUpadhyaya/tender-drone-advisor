# Placeholder-only production configuration. Store real values in a secret manager.
APP_ENV=production
DEMO_MODE=false
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://issuer.example.invalid/
OIDC_AUDIENCE=tender-drone-advisor-api
CORS_ORIGINS=https://app.example.invalid
DATABASE_URL=postgresql+psycopg://<secret>@<managed-postgres-host>:5432/tender_advisor
REDIS_URL=rediss://<secret>@<managed-redis-host>:6380/0
S3_ENDPOINT=https://s3.example.invalid
S3_BUCKET=tender-documents-production
S3_ACCESS_KEY=<from-secret-manager>
S3_SECRET_KEY=<from-secret-manager>
LLM_PROVIDER=<approved-provider>
LLM_API_KEY=<from-secret-manager>
RAG_EXTERNAL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.invalid
