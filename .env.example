# Safe placeholders only. Copy to an untracked .env for local development.
APP_ENV=development
DEMO_MODE=true
AUTH_MODE=demo
# Production: DEMO_MODE=false, AUTH_MODE=oidc and configure the validated verifier.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
DEFAULT_WORKSPACE_ID=local-demo
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
POSTGRES_DB=tender_advisor
POSTGRES_USER=tender_advisor
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://tender_advisor:replace-with-local-password@postgres:5432/tender_advisor
# Leave blank/None to disable psycopg server-prepared statements in pooled workers.
PSYCOPG_PREPARE_THRESHOLD=
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tender-documents
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=250
UPLOAD_RATE_LIMIT_PER_MINUTE=12
GENERATION_RATE_LIMIT_PER_MINUTE=30
JOB_STALE_SECONDS=900
LOG_LEVEL=INFO
INGESTION_QUEUE=tender_ingestion
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fixture-v1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
EXTRACTION_MAX_REPAIRS=1
EXTRACTION_TRANSIENT_RETRIES=1
EXTRACTION_CONFIDENCE_THRESHOLD=0.8
EXTRACTION_BATCH_CHARS=12000
EXTRACTION_MAX_BATCHES=32
# C06 defaults remain local even when C03 OpenAI is configured.
RAG_NAMESPACE=local-demo
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=hash-v1
RAG_EMBEDDING_DIMENSIONS=256
RAG_REPORT_PROVIDER=fake
RAG_REPORT_MODEL=fixture-report-v1
# External processing additionally requires allow_external=true per request.
RAG_EXTERNAL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
